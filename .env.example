# Server Environment Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration (MongoDB Cloud / Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/justmemes

# Admin password required to call GET /orders (sent via x-admin-pwd header)
ADMIN_PWD=change-me

# PhonePe Payment Gateway (UAT / Production) Credentials
# Add these to Google Cloud Run Service Environment Variables
PHONEPE_MERCHANT_ID=M222AV357KIE0_2608092254
PHONEPE_SALT_KEY=b3cf3674-da8c-42c0-ba2b-d75901623c6d
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PHONEPE_CALLBACK_URL=https://justmemes-backend-531422631456.asia-south1.run.app/payments/phonepe/callback

# Mock Mode (Set to true to bypass PhonePe API calls during local testing)
PHONEPE_MOCK=false

# Razorpay Payment Gateway Credentials
# Key ID is publishable; Key Secret is SECRET and must ONLY live on the server.
# Add these to Google Cloud Run Service Environment Variables.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
